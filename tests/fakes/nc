#!/bin/bash
# FAKE_OPEN_PORTS is a space-separated list of ports that accept connections. Ports listed in
# $FAKE_LOG.ports, which the launchctl and systemsetup fakes write to, are open as well.
printf 'nc %s\n' "$*" >> "$FAKE_LOG"
port="${*: -1}"
case " ${FAKE_OPEN_PORTS:-} $(cat "$FAKE_LOG.ports" 2>/dev/null | tr '\n' ' ') " in
  *" $port "*) exit 0 ;;
esac
exit 1
